# Raw hackathon data provided by BMW - never commit
BMW-Data/

# Generated by `python -m bmw_feedback build/train` (re-creatable)
data/processed/
data/decisions.jsonl
models/

# Data files
*.csv
*.csv.gz
*.zip
*.json
*.xlsx
*.PDF
*.pdf
*.joblib

# Keep the small report outputs that REPORT.md references
!reports/*.csv
!reports/*.json

# Web app configs (package.json, tsconfig, lockfile) are source, not data
!frontend/**/*.json
frontend/node_modules/
frontend/dist/

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
.eggs/
*.egg

# Virtual environments
venv/
.venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
Thumbs.db
.DS_Store

# Jupyter
.ipynb_checkpoints/

# Legacy procurement (Demandra) code moved out of the way; recoverable from git history
archive/

# Secrets (OpenAI key for the agents)
.env

# BMW brand assets fetched locally by frontend/scripts/fetch-brand-assets.cjs - trademark / licensed, never commit
frontend/public/brand/
frontend/public/fonts/

# TypeScript incremental build cache
*.tsbuildinfo
.pytest_cache/
