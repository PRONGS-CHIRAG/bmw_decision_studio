# Confidential BMW material — repo is public, never commit
BMW-Data/
BMW_Hackathon_Briefing_Short.pdf

# Secrets
.env
.env.*
!.env.example

# Data files
*.csv
*.csv.gz
*.zip
*.json
*.xlsx
*.PDF
*.pdf
*.joblib

# Keep the small report outputs that REPORT.md references
!reports/*.csv
!reports/*.json

# Generated data and trained models are tracked (the *.csv/*.json/*.joblib rules above would otherwise hide them)
!data/**
!models/**

# Web app configs (package.json, tsconfig, lockfile) are source, not data
!frontend/**/*.json
frontend/node_modules/
frontend/dist/

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
.eggs/
*.egg

# Virtual environments
venv/
.venv/
env/
.pytest_cache/
.ruff_cache/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
Thumbs.db
.DS_Store

# Jupyter
.ipynb_checkpoints/

# Legacy procurement (Demandra) code moved out of the way; recoverable from git history
archive/

# BMW brand assets fetched locally by frontend/scripts/fetch-brand-assets.cjs - trademark / licensed.
# Only the colour roundel is committed, so the deployed header shows it; the white logo and the font stay local.
frontend/public/brand/*
!frontend/public/brand/bmw-logo-colour.svg
frontend/public/fonts/

# TypeScript incremental build cache
*.tsbuildinfo
.pytest_cache/

# Competitor web snapshots (raw pages/PDFs and their text): public but third-party content, re-fetchable from
# the manifest in data/processed/competitor_sources.csv. The extracted rows in competitor-data/extracted/ are tracked.
competitor-data/raw/
competitor-data/text/

# Node / Next.js
node_modules/
.next/
out/

# Local data
*.sqlite
*.sqlite3
*.db

# Motion film built from confidential BMW data -- never commit
motion-video/
